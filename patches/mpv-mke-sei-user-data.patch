+// [stream_player test patch] SEI user_data_unregistered of the frame on screen,
+// as hex (16-byte UUID + payload). Several messages are separated by ','.
+// Unavailable when the frame carries none.
+static int mp_property_sei_user_data(void *ctx, struct m_property *prop,
+                                     int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    if (!mpctx->video_out)
+        return M_PROPERTY_UNAVAILABLE;
+
+    struct mp_image *f = vo_get_current_frame(mpctx->video_out);
+    if (!f)
+        return M_PROPERTY_UNAVAILABLE;
+
+    char *hex = NULL;
+    for (int n = 0; n < f->num_ff_side_data; n++) {
+        struct mp_ff_side_data *sd = &f->ff_side_data[n];
+        if (sd->type != AV_FRAME_DATA_SEI_UNREGISTERED || !sd->buf)
+            continue;
+        hex = hex ? talloc_strdup_append_buffer(hex, ",") : talloc_strdup(NULL, "");
+        for (size_t i = 0; i < sd->buf->size; i++)
+            hex = talloc_asprintf_append_buffer(hex, "%02x", sd->buf->data[i]);
+    }
+    talloc_free(f);
+    if (!hex)
+        return M_PROPERTY_UNAVAILABLE;
+
+    int r = m_property_strdup_ro(action, arg, hex);
+    talloc_free(hex);
+    return r;
+}
